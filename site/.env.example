# Production origin used for canonical URLs, Open Graph and the sitemap.
# Set this to your real domain, e.g. https://yourdomain.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# nhentai API v2 (https://nhentai.net/api/v2/docs)
# Create a key under nhentai → Settings → API keys, then set it here and in
# your host's environment variables (Vercel → Settings → Environment Variables).
NHENTAI_API_KEY=