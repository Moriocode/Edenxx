# Production origin used for canonical URLs, Open Graph and the sitemap.
# Set this to your real domain, e.g. https://yourdomain.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# nhentai API v2 (https://nhentai.net/api/v2/docs)
# Create a key under nhentai → Settings → API keys, then set it here and in
# your host's environment variables (Vercel → Settings → Environment Variables).
NHENTAI_API_KEY=

# --- Hidden page-view analytics ---------------------------------------------
# Redis over HTTP. Set this pair to the values Vercel KV / Upstash gives you.
# Vercel: Storage → create a KV (Upstash for Redis) store → connect to project,
# which injects KV_REST_API_URL and KV_REST_API_TOKEN automatically.
# Upstash directly: use UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash-direct alternative (used only when the KV_* pair is empty):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Required to read the numbers: GET /api/visit with
#   Authorization: Bearer <this value>
# Long random string; never exposed to the browser.
ANALYTICS_ADMIN_TOKEN=
